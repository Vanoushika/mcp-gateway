# Copy to .env for local runs. Never commit a real .env.
# When set, every route except /health requires this key in X-API-Key.
MCP_GATEWAY_API_KEY=
# SQLite by default; point at PostgreSQL in production.
DATABASE_URL=sqlite:///./gateway.db
# Seconds between periodic health checks of remote servers (default 60).
MCP_GATEWAY_HEALTH_INTERVAL_SECONDS=60
